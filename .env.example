# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # service_role / secret key (NIKDY do prohlížeče)

# Veřejná adresa aplikace (pro odkazy v e-mailech)
NEXT_PUBLIC_SITE_URL=https://kontroly.example.cz

# E-maily přes Resend (https://resend.com). Bez klíče se e-maily jen zapíší do logu
# a odkaz na pozvánku se zobrazí správci přímo v aplikaci.
RESEND_API_KEY=
EMAIL_FROM="Mystery Shopping <kontroly@example.cz>"

# Název aplikace v hlavičce a v e-mailech
NEXT_PUBLIC_APP_NAME=Mystery Shopping

# Libovolný dlouhý náhodný řetězec, chrání /api/cron
CRON_SECRET=
